# Copiar a .env local y cambiar el marcador antes de iniciar PostgreSQL.
# La clave en DATABASE_URL debe coincidir con POSTGRES_PASSWORD.
POSTGRES_PASSWORD=CAMBIAR_ANTES_DE_USAR
DATABASE_URL=postgresql+psycopg://smartpark:CAMBIAR_ANTES_DE_USAR@localhost:5432/smartpark
AUTH_SECRET_KEY=
AUTH_TOKEN_MINUTES=480
AI_BASE_URL=http://127.0.0.1:8001
FACE_MATCH_THRESHOLD=0.70
AWS_REGION=us-east-1
SMARTPARK_MEDIA_BUCKET=
