/* ============================================================
   SMARTPARK - GUARDIA V2 / AUTH / STAFF
   ============================================================ */


/* ============================================================
   GUARDIA - CONTENEDOR GENERAL
   ============================================================ */

.guard-page-v2 {
  width: 100%;
  max-width: 1500px;

  margin: 0 auto;
  padding-bottom: 28px;
}


.guard-heading-v2 {
  margin-bottom: 18px;
}


.guard-title-row {
  display: flex;
  align-items: center;

  gap: 12px;

  flex-wrap: wrap;
}


.guard-title-row h2 {
  margin: 0;
}


.guard-system-pill {
  display: inline-flex;
  align-items: center;

  gap: 7px;

  min-height: 28px;

  padding: 0 10px;

  border-radius: 999px;

  background: #eef2f7;
  color: #526173;

  font-size: 0.72rem;
  font-weight: 800;
  letter-spacing: 0.04em;
}


.guard-system-pill > span {
  width: 8px;
  height: 8px;

  border-radius: 999px;

  background: currentColor;
}


.guard-system-pill.online {
  background: #e8f9ef;
  color: #128a49;
}


.guard-system-pill.offline {
  background: #fff0ef;
  color: #c73d36;
}


.compact-alert-stack {
  margin-bottom: 14px;
}


/* ============================================================
   GUARDIA - ESTADOS SUPERIORES
   ============================================================ */

.guard-health-strip {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 10px;

  margin-bottom: 14px;
}


.health-dot-card {
  min-width: 0;
  min-height: 64px;

  display: grid;

  grid-template-columns:
    auto minmax(0, 1fr);

  grid-template-rows:
    auto auto;

  column-gap: 11px;

  align-items: center;

  padding: 11px 14px;

  border: 1px solid #dfe7f0;
  border-radius: 14px;

  background: #ffffff;

  box-shadow:
    0 4px 14px
    rgba(15, 23, 42, 0.035);
}


.health-dot-card svg {
  grid-row: 1 / span 2;

  flex: 0 0 auto;

  color: #6b7c93;
}


.health-dot-card span,
.health-dot-card strong {
  min-width: 0;

  overflow: hidden;

  text-overflow: ellipsis;
  white-space: nowrap;
}


.health-dot-card span {
  color: #7b8aa0;

  font-size: 0.72rem;
}


.health-dot-card strong {
  color: #122033;

  font-size: 0.84rem;
}


.health-dot-card.online svg,
.health-dot-card.online strong {
  color: #16964e;
}


.health-dot-card.offline svg,
.health-dot-card.offline strong {
  color: #d44b44;
}


.health-dot-card.warning svg,
.health-dot-card.warning strong {
  color: #d18117;
}


/* ============================================================
   GUARDIA - GRID PRINCIPAL
   ============================================================ */

.guard-operations-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.68fr)
    minmax(340px, 0.72fr);

  gap: 14px;

  align-items: start;
}


.guard-camera-panel-v2,
.guard-access-panel-v2,
.guard-current-result-card {
  min-width: 0;

  overflow: hidden;

  border: 1px solid #dfe7f0;
  border-radius: 16px;

  background: #ffffff;

  box-shadow:
    0 5px 18px
    rgba(15, 23, 42, 0.04);
}


/* ============================================================
   GUARDIA - CABECERA DE PANELES
   ============================================================ */

.guard-panel-title {
  min-height: 66px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 12px;

  padding: 15px 18px;

  border-bottom: 1px solid #e7ecf2;
}


.guard-panel-title > div {
  min-width: 0;

  display: flex;
  align-items: center;

  gap: 10px;
}


.guard-panel-title strong,
.guard-panel-title small {
  display: block;
}


.guard-panel-title strong {
  color: #15253a;
}


.guard-panel-title small {
  margin-top: 3px;

  color: #748198;

  font-size: 10px;
  line-height: 1.4;
}


.live-dot {
  width: 10px;
  height: 10px;

  flex: 0 0 auto;

  border-radius: 50%;

  background: #ef4444;

  box-shadow:
    0 0 0 4px
    rgba(239, 68, 68, 0.1);
}


.live-dot.active {
  background: #22c55e;

  box-shadow:
    0 0 0 4px
    rgba(34, 197, 94, 0.12);
}


.guard-chip {
  flex: 0 0 auto;

  padding: 6px 9px;

  border-radius: 999px;

  background: #eef2ff;
  color: #4338ca;

  font-size: 10px;
  font-weight: 800;

  white-space: nowrap;
}


/* ============================================================
   GUARDIA - CÁMARA EDGE
   ============================================================ */

.guard-camera-panel-v2 {
  align-self: start;

  display: flex;
  flex-direction: column;
}


.guard-camera-frame-v2 {
  position: relative;

  width: 100%;

  min-height: 430px;
  height: clamp(430px, 55vh, 590px);

  overflow: hidden;

  display: grid;
  place-items: center;

  background:
    radial-gradient(
      circle at 50% 30%,
      rgba(40, 63, 89, 0.24),
      transparent 36%
    ),
    #050b13;
}


.guard-camera-frame-v2 > img {
  width: 100%;
  height: 100%;

  min-height: 0;

  display: block;

  object-fit: contain;
}


.guard-camera-placeholder-v2 {
  width: min(520px, 100%);
  max-width: 520px;

  margin: 0 auto;
  padding: 36px;

  color: #dbe4ef;

  text-align: center;
}


.guard-camera-placeholder-v2 svg {
  margin: 0 auto 16px;

  color: #64748b;
}


.guard-camera-placeholder-v2 strong {
  display: block;

  color: #f8fafc;

  font-size: 18px;
}


.guard-camera-placeholder-v2 p {
  max-width: 460px;

  margin: 10px auto 0;

  color: #8494a8;

  line-height: 1.55;
}


.guard-camera-overlay {
  position: absolute;

  z-index: 2;

  padding: 7px 10px;

  border-radius: 7px;

  background:
    rgba(3, 7, 18, 0.78);

  color: #ffffff;

  font-size: 10px;
  font-weight: 900;
  letter-spacing: 0.04em;
}


.guard-camera-overlay.top-left {
  top: 14px;
  left: 14px;
}


.guard-camera-overlay.bottom-left {
  left: 14px;
  bottom: 14px;
}


/* ============================================================
   GUARDIA - COLUMNA DERECHA
   ============================================================ */

.guard-control-column {
  min-width: 0;

  align-self: start;

  display: flex;
  flex-direction: column;

  gap: 14px;
}


.guard-access-panel-v2 {
  padding-bottom: 12px;
}


.guard-stage-current-v2 {
  margin:
    0 14px 12px;

  padding: 12px 14px;

  border: 1px solid #e0e8f1;
  border-radius: 12px;

  background: #f4f8fc;
}


.guard-stage-current span,
.guard-stage-current strong {
  display: block;
}


.guard-stage-current span {
  margin-bottom: 6px;

  color: #64748b;

  font-size: 10px;
  letter-spacing: 0.08em;

  text-transform: uppercase;
}


.guard-stage-current strong {
  color: #0f172a;

  font-size: 15px;
}


.compact-flow-list {
  padding: 0 14px;
}


.compact-flow-list .guard-flow-step,
.guard-flow-step {
  position: relative;

  min-height: 34px;

  display: flex;
  align-items: center;

  gap: 10px;

  color: #94a3b8;

  font-size: 11px;
}


.guard-flow-step::after {
  content: "";

  position: absolute;

  left: 12px;
  top: 28px;

  width: 1px;
  height: 16px;

  background: #e2e8f0;
}


.guard-flow-step:last-child::after {
  display: none;
}


.guard-flow-step.active {
  color: #172033;

  font-weight: 800;
}


.guard-flow-step.done {
  color: #15803d;
}


.guard-flow-index {
  width: 25px;
  height: 25px;

  flex: 0 0 auto;

  display: grid;
  place-items: center;

  border: 1px solid #dbe3ec;
  border-radius: 50%;

  background: #ffffff;

  font-size: 9px;
  font-weight: 900;
}


.guard-flow-step.active .guard-flow-index {
  border-color: #3b82f6;

  background: #dbeafe;
  color: #1d4ed8;
}


.guard-flow-step.done .guard-flow-index {
  border-color: #86efac;

  background: #dcfce7;
  color: #15803d;
}


/* ============================================================
   GUARDIA - ÚLTIMO RESULTADO AWS
   ============================================================ */

.guard-current-result-card {
  padding: 16px;
}


.guard-current-result-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 12px;

  flex-wrap: wrap;

  margin-bottom: 12px;
}


.guard-current-result-header > span {
  color: #75859a;

  font-size: 0.78rem;
  font-weight: 700;

  text-transform: uppercase;
}


.guard-current-result-header > strong {
  font-size: 0.82rem;
  line-height: 1.35;
}


.guard-current-result-header > strong.authorized {
  color: #0d8c45;
}


.guard-current-result-header > strong.rejected {
  color: #c43b34;
}


.guard-current-result-header > strong.review {
  color: #b26a10;
}


.guard-current-result-header > strong.neutral {
  color: #64748b;
}


.guard-current-result-data {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 8px;
}


.guard-current-result-data > div {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 4px;

  padding: 10px;

  border: 1px solid #e8edf3;
  border-radius: 10px;

  background: #f8fafc;
}


.guard-current-result-data > div.wide {
  grid-column: 1 / -1;
}


.guard-current-result-data span {
  color: #7a8a9f;

  font-size: 0.68rem;

  text-transform: uppercase;
}


.guard-current-result-data strong {
  color: #142235;

  font-size: 0.84rem;
  line-height: 1.35;

  overflow-wrap: anywhere;
}


/* ============================================================
   GUARDIA - PARTE INFERIOR
   ============================================================ */

.guard-lower-grid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.45fr)
    minmax(320px, 0.55fr);

  gap: 14px;

  margin-top: 14px;

  align-items: start;
}


.guard-recent-panel-v2,
.guard-manual-panel-v2 {
  min-width: 0;
  min-height: 0;

  align-self: start;
}


/* ============================================================
   GUARDIA - EVENTOS RECIENTES
   ============================================================ */

.guard-events-list {
  display: flex;
  flex-direction: column;

  padding: 0 18px 16px;
}


.guard-event-row {
  display: grid;

  grid-template-columns:
    minmax(110px, 0.9fr)
    minmax(150px, 1.25fr)
    auto;

  gap: 16px;

  align-items: center;

  padding: 12px 2px;

  border-top: 1px solid #e7edf4;
}


.guard-event-row:first-child {
  border-top: 0;
}


.guard-event-time,
.guard-event-person {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 3px;
}


.guard-event-time strong,
.guard-event-person strong {
  color: #162438;

  font-size: 0.85rem;
}


.guard-event-time span,
.guard-event-person span {
  color: #78889c;

  font-size: 0.75rem;

  overflow-wrap: anywhere;
}


.guard-table-decision {
  display: inline-flex;

  justify-self: end;

  padding: 5px 8px;

  border-radius: 999px;

  font-size: 9px;
  font-weight: 900;

  white-space: nowrap;
}


.guard-table-decision.authorized {
  background: #dcfce7;
  color: #166534;
}


.guard-table-decision.rejected {
  background: #fee2e2;
  color: #991b1b;
}


.guard-table-decision.review {
  background: #fef3c7;
  color: #92400e;
}


.guard-table-decision.neutral {
  background: #f1f5f9;
  color: #475569;
}


/* ============================================================
   GUARDIA - CONTROL MANUAL DE BARRERA
   ============================================================ */

.barrier-state-box {
  display: flex;
  flex-direction: column;

  gap: 4px;

  margin:
    0 18px 12px;

  padding: 14px;

  border: 1px solid #e1e9f1;
  border-radius: 12px;

  background: #f6f9fc;
}


.barrier-state-box span,
.barrier-state-box small {
  color: #78889c;

  font-size: 0.72rem;
  line-height: 1.45;
}


.barrier-state-box strong {
  color: #162438;

  font-size: 0.95rem;
}


.guard-manual-actions {
  display: grid;

  grid-template-columns: 1fr;

  gap: 10px;

  padding: 0 18px;
}


.gate-open-button {
  width: 100%;
  min-height: 44px;
}


.danger-outline-button {
  width: 100%;
  min-height: 44px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  padding: 0 14px;

  border: 1px solid #efb3af;
  border-radius: 10px;

  background: #ffffff;
  color: #c53a34;

  font-weight: 700;

  cursor: pointer;

  transition:
    background 0.2s,
    border-color 0.2s,
    color 0.2s;
}


.danger-outline-button:hover:not(:disabled) {
  border-color: #e98f89;

  background: #fff5f4;
}


.danger-outline-button:disabled {
  cursor: not-allowed;

  opacity: 0.55;
}


.guard-manual-notice {
  margin:
    10px 18px 0;

  padding: 10px 12px;

  border-radius: 10px;

  background: #f4f8fc;
  color: #41546a;

  font-size: 0.78rem;
}


.guard-manual-help {
  margin:
    14px 18px 18px;

  color: #64748b;

  font-size: 11px;
  line-height: 1.5;
}


/* ============================================================
   GUARDIA - MODAL CONTROL MANUAL
   ============================================================ */

.guard-manual-modal-v2 {
  width: min(560px, 100%);
  max-width: 560px;
}


.guard-manual-modal-v2 > label {
  display: grid;

  gap: 7px;

  padding:
    0 24px 14px;

  color: #334155;

  font-size: 13px;
  font-weight: 700;
}


.guard-manual-modal-v2 select,
.guard-manual-modal-v2 textarea {
  width: 100%;

  padding: 12px 13px;

  outline: none;

  border: 1px solid #dbe2ea;
  border-radius: 9px;

  background: #ffffff;
  color: #172033;
}


.guard-manual-modal-v2 textarea {
  resize: vertical;
}


.guard-manual-modal-v2 select:focus,
.guard-manual-modal-v2 textarea:focus {
  border-color: #22c55e;

  box-shadow:
    0 0 0 3px
    rgba(34, 197, 94, 0.12);
}


.guard-manual-modal-v2 .modal-actions {
  padding:
    0 24px 24px;
}


.guard-manual-modal-v2 .alert {
  margin:
    0 24px 14px;
}


.modal-warning-box {
  margin:
    0 24px 14px;

  padding: 10px 12px;

  border: 1px solid #f1d78e;
  border-radius: 10px;

  background: #fff8e7;
  color: #76551a;

  font-size: 0.8rem;
  line-height: 1.5;
}


/* ============================================================
   LOGIN V2
   ============================================================ */

.login-card-v2 {
  max-width: 520px;
}


.smartpark-login-form {
  display: grid;

  gap: 14px;

  margin-top: 22px;
}


.smartpark-login-form label,
.staff-form label {
  display: grid;

  gap: 7px;
}


.smartpark-login-form label > span,
.staff-form label > span {
  color: #44566c;

  font-size: 0.78rem;
  font-weight: 700;
}


.smartpark-login-form label > span {
  color: #9fb0c4;
}


.login-input-wrap {
  min-height: 48px;

  display: flex;
  align-items: center;

  gap: 10px;

  padding: 0 13px;

  border: 1px solid #d7e1ec;
  border-radius: 12px;

  background: #ffffff;
}


.login-input-wrap:focus-within {
  border-color: #22c55e;

  box-shadow:
    0 0 0 3px
    rgba(34, 197, 94, 0.12);
}


.login-input-wrap svg {
  color: #8190a3;
}


.login-input-wrap input {
  min-width: 0;

  flex: 1;

  border: 0;
  outline: 0;

  background: transparent;
  color: #112135;
}


.login-submit-button {
  min-height: 48px;

  justify-content: center;
}


.login-security-note {
  margin-top: 14px;

  color: #8fa2b8;

  font-size: 12px;

  text-align: center;
}


.login-error {
  margin-bottom: 0;
}


/* ============================================================
   STAFF V2
   ============================================================ */

.staff-page-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;

  gap: 16px;
}


.staff-message-stack {
  display: grid;

  gap: 8px;

  margin-bottom: 14px;
}


.staff-message-stack .alert {
  margin-bottom: 0;
}


.staff-workspace-grid {
  display: grid;

  grid-template-columns:
    minmax(320px, 0.68fr)
    minmax(0, 1.32fr);

  gap: 16px;

  align-items: start;
}


.staff-create-panel,
.staff-list-panel {
  align-self: start;
}


.staff-form {
  display: grid;

  gap: 14px;

  padding:
    18px 20px 20px;
}


.staff-form input,
.staff-form select {
  width: 100%;
  min-height: 42px;

  padding: 0 12px;

  outline: none;

  border: 1px solid #d8e2ec;
  border-radius: 10px;

  background: #ffffff;
  color: #15253a;
}


.staff-form input:focus,
.staff-form select:focus {
  border-color: #22c55e;

  box-shadow:
    0 0 0 3px
    rgba(34, 197, 94, 0.12);
}


.staff-account-list {
  display: flex;
  flex-direction: column;

  padding:
    0 20px 14px;
}


.staff-account-row {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  padding: 14px 0;

  border-top: 1px solid #e8edf3;
}


.staff-account-row:first-child {
  border-top: 0;
}


.staff-account-main,
.staff-account-actions {
  display: flex;
  align-items: center;

  gap: 12px;
}


.staff-account-main {
  min-width: 0;
}


.staff-account-main > div {
  min-width: 0;

  display: flex;
  flex-direction: column;

  gap: 3px;
}


.staff-account-main strong {
  color: #15253a;
}


.staff-account-main span:not(.staff-role-badge) {
  color: #7b8a9d;

  font-size: 0.77rem;

  overflow-wrap: anywhere;
}


.status-badge.inactive {
  background: #eef2f6;
  color: #718095;
}


.compact-button {
  min-height: 34px;

  padding: 0 10px;

  font-size: 0.76rem;
}


/* ============================================================
   RESPONSIVE - SMARTPARK V2
   ============================================================ */

@media (max-width: 1250px) {

  .guard-operations-grid {
    grid-template-columns:
      minmax(0, 1.5fr)
      minmax(320px, 0.8fr);
  }


  .guard-camera-frame-v2 {
    min-height: 390px;
    height: clamp(390px, 50vh, 530px);
  }

}


@media (max-width: 1120px) {

  .guard-operations-grid,
  .guard-lower-grid,
  .staff-workspace-grid {
    grid-template-columns: 1fr;
  }


  .guard-health-strip {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }


  .guard-control-column {
    display: grid;

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    align-items: start;
  }


  .guard-camera-frame-v2 {
    min-height: 360px;
    height: clamp(360px, 48vh, 500px);
  }

}


@media (max-width: 760px) {

  .login-card {
    padding: 30px 22px;
  }


  .guard-health-strip {
    grid-template-columns: 1fr;
  }


  .guard-control-column {
    display: flex;
    flex-direction: column;
  }


  .guard-heading {
    align-items: flex-start;
    flex-direction: column;
  }


  .guard-heading > button {
    width: 100%;
  }


  .guard-camera-frame-v2 {
    min-height: 290px;
    height: 42vh;
  }


  .guard-current-result-data {
    grid-template-columns: 1fr;
  }


  .guard-current-result-data > div.wide {
    grid-column: auto;
  }


  .guard-event-row {
    grid-template-columns: 1fr;

    gap: 8px;
  }


  .guard-table-decision {
    justify-self: start;
  }


  .staff-page-heading,
  .staff-account-row,
  .staff-account-actions {
    align-items: stretch;
    flex-direction: column;
  }


  .staff-account-main {
    align-items: flex-start;
  }


  .staff-account-actions {
    width: 100%;
  }


  .staff-account-actions .secondary-button {
    width: 100%;
  }

}


@media (max-width: 520px) {

  .guard-camera-frame-v2 {
    min-height: 250px;
    height: 38vh;
  }


  .guard-camera-placeholder-v2 {
    padding: 24px 18px;
  }


  .guard-panel-title {
    align-items: flex-start;
    flex-direction: column;
  }


  .guard-chip {
    align-self: flex-start;
  }

}